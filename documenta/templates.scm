#| Templates.

Procedures that accept data and present it in different ways depending
on the target documentation format (texinfo, HTML, etc.). |#

(define-module (documenta templates)
  #:use-module (documenta data)
  #:use-module (documenta utils)
  #:use-module (ice-9 format)
  #:use-module (ice-9 regex)
  #:use-module (ice-9 session)
  #:use-module (srfi srfi-1)
  #:use-module (texinfo)
  #:use-module (texinfo reflection)
  #:export (stexi:api-binding
            stexi:api-chapter
            stexi:module-description
            stexi:module-section
            stexi:procedure-parameters))


;;; TEMPLATES

(define (stexi:api-binding name value)
  "Return the API binding as an stexi definition.

  NAME (symbol):
    The name of the binding. For example, the name of a variable,
    the name of a procedure, etc.

  VALUE (anything):
    Any kind of object. For example, a string, a list, a procedure, a
    record, etc.

  RETURN VALUE (stexi):
    An stexi definition corresponding to the type of VALUE."
  (let [(name-string (symbol->string name))]

    (cond
     [(macro? value)
      `(defmac
         (% (name ,name-string)
            (arguments))  ; TODO: Render arguments.
         (verbatim ,(format #f "~s" value)))]
     [(procedure? value)
      `(deffn
         (% (category "Procedure")
            (name ,name-string)
            (arguments ,(stexi:procedure-parameters value)))
         ,@(cdr                         ; To remove *fragment* atom.
            (texi-fragment->stexi
             (unindent (procedure-documentation value)))))]
     [(record-type? value)
      `(deftp
         (% (category "Record type")
            (name ,name-string)
            (attributes))
         (para "This record type has the following fields:")
         (itemize
          ,@(map
             (lambda (field)
               `(item (code ,(symbol->string field))))
             (record-type-fields value))))]
     [(record? value)
      (let* [(descriptor (record-type-descriptor value))
             (type-name (record-type-name descriptor))
             (record-fields (record-type-fields descriptor))]

        `(defvar
           (% (name ,name-string))
           (para "This is a record of the type "
                 (code ,(symbol->string type-name)) ", "
                 "which has the following fields:")
           (itemize
            ,@(map
               (lambda (field)
                 `(item (code ,(symbol->string field))))
               record-fields))))]
     [else
      `(defvr
         (% (category "Variable") (name ,name-string))
         (verbatim ,(format #f "~s" value)))])))


(define (stexi:api-chapter sections)
  "Return a library API as an stexi chapter.

  SECTIONS (list of stexi):
    A list where every item is an stexi section.

  RETURN VALUE (stexi):
    A chapter documenting a library's API."
  `(*fragment*
    (c (% (all "NOTE: Autogenerated documentation. Do not edit manually.")))
    (node (% (name "API")))
    (chapter "API")
    (para "The following is the list of modules provided by this library.")
    ,@sections))


(define (stexi:module-description module-name)
  "Return the module's commentary or description as stexi.

  MODULE-NAME (list of symbols):
    For example: '(mylib amodule).

  RETURN VALUE (stexi):
    An stexi fragment."
  (let* [(commentary (module-commentary module-name))
         ;; FIXME: Ignore delimiters, capture the comment only.
         ;; Maybe "(?<=#\|\s)(.*)(?=\s\|#$)" but the ? of lookahead and
         ;; look behind makes the regex invalid in Guile...
         (comment-regex ".*#\\|\\s(.*)\\s\\|#.*$")  ; TODO: Improve regex.
         (block-commentary (string-match comment-regex commentary))]

    (if block-commentary
        (texi-fragment->stexi (match:substring block-commentary 1))
        (texi-fragment->stexi commentary))))


(define (stexi:module-section module-name)
  "Return the module documentation as an stexi section.

  MODULE-NAME (list of symbols):
    For example: '(mylib amodule).

  RETURN VALUE (stexi):
    A section documenting a module's API."
  (let* [(module-api (resolve-interface module-name))
         (grouped-api-objects (group-api-objects module-api))
         (node-name (string-join (map symbol->string module-name)
                                 "-"))]

    `(*fragment*
      (node (% (name ,node-name)))
      (section ,(format #f "~a" module-name))
      ,(stexi:module-description module-name)
      (para "This module provides the following interface.")

      ,@(map
         (lambda (group)
           (let [(kind (first group))
                 (objects (cdr group))]
             (stexi:module-subsection kind objects)))
         grouped-api-objects))))


(define (stexi:module-subsection kind objects)
  "Return an stexi subsection listing API objects of the given KIND.

  KIND (string):
    Any of the kinds defined by the procedure 'group-api-objects' from
    the module (documenta data).

  OBJECTS (alist):
    Association list of API objects of the given KIND. Every key is the
    symbol identifying an object, and every value is the object itself
    (a procedure, a macro, a record, etc.).

  RETURN VALUE (stexi):
    An stexi subsection."
  `(*fragment*
    (subsection ,(string-capitalize kind))

    ,@(map
       (lambda (object)
         (let [(key (first object))
               (value (cdr object))]
           (stexi:api-binding key value)))
       objects)))


(define (stexi:procedure-parameters proc)
  "Return the parameters of the given procedure as a string.

  PROC (procedure):
    A procedure object.

  RETURN VALUE (string):
    A string listing the names of all the required, optional, keyword,
    and rest of parameters of the procedure. Default values for optional
    and keyword parameters are not included."
  ;; Helper.
  (define (symbol-or-pair->string obj)
    (format #f "~s" obj))
  (define (keyword->string keyword)
    (format #f "~a" (car keyword)))
  ;; Main body.
  (let* [(parameters (procedure-arguments proc))
         (required-params (assoc-ref parameters 'required))
         (optional-params (assoc-ref parameters 'optional))
         (keyword-params (assoc-ref parameters 'keyword))
         (arbitrary-keys? (assoc-ref parameters 'allow-other-keys?))
         (rest? (assoc-ref parameters 'rest))]

    (string-join
     (append
      (map symbol->string required-params)
      (if (null? optional-params)
          (list)
          (cons "OPT:"
                (map symbol-or-pair->string optional-params)))
      (if (null? keyword-params)
          (list)
          (cons "KEY:" (map keyword->string keyword-params)))
      (if arbitrary-keys?
          (list "[arbitrary keys]")
          (list))
      (if rest?
          (list "[arbitrary arguments]")
          (list)))
     " ")))
