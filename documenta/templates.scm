#| Templates.

Procedures that accept data and present it in different ways depending
on the target documentation format (texinfo, HTML, etc.). |#

(define-module (documenta templates)
  #:use-module (ice-9 format)
  #:use-module (ice-9 session)
  #:use-module (srfi srfi-1)
  #:use-module (texinfo)
  #:use-module (texinfo reflection)
  #:export (stexi:api-binding
            stexi:api-chapter
            stexi:module-section
            stexi:procedure-parameters))


;;; TEMPLATES

(define (stexi:api-binding name value)
  "Return the API binding as an stexi definition.

  NAME (symbol)
    The name of the binding. For example, the name of a variable,
    the name of a procedure, etc.

  VALUE (anything)
    Any kind of object. For example, a string, a list, a procedure, a
    record, etc.

  RETURN VALUE (stexi)
    An stexi definition corresponding to the type of VALUE."
  (let [(name-string (symbol->string name))]

    (cond
     [(procedure? value)
      `(deffn
         (% (category "Procedure")
            (name ,name-string)
            ,(stexi:procedure-parameters value))
         ,@(cdr                         ; To remove *fragment* atom.
            (texi-fragment->stexi (procedure-documentation value))))]
     [(record-type? value)
      `(deftp
         (% (category "Record") (name ,name-string) (attributes))
         (para "TODO: This record type has the following properties:"))]
     [else
      `(defvr
         (% (category "Variable")
            (name ,name-string))
         (verbatim ,(format #f "~s" value)))])))


(define (stexi:api-chapter sections)
  "Return a library API as an stexi chapter.

  SECTIONS (list of stexi)
    A list where every item is an stexi section.

  RETURN VALUE (stexi)
    A chapter documenting a library's API."
  `(*fragment*
    (c (% (all "NOTE: Autogenerated documentation. Do not edit manually.")))
    (node (% (name "API")))
    (chapter "API")
    (para "The following is the list of modules provided by this library.")
    ,@sections))


(define (stexi:module-section module-name)
  "Return the module documentation as an stexi section.

  MODULE-NAME (list of symbols)
    For example: '(mylib amodule).

  RETURN VALUE (stexi)
    A section documenting a module's API."
  (let* [(module-api (resolve-interface module-name))
         (api-descriptor (record-type-descriptor module-api))
         (api-bindings (get-field module-api 'obarray))
         (node-name (string-join (map symbol->string module-name)
                                 "-"))]

    `(*fragment*
      (node (% (name ,node-name)))
      (section ,(format #f "~a" module-name))
      (para "This module provides the following interface.")

      ,@(hash-map->list
         (lambda (key var)
           (stexi:api-binding key (variable-ref var)))
         api-bindings))))


(define (stexi:procedure-parameters proc)
  "Return the parameters of the procedure as stexi arguments."
  (let* [(parameters (procedure-arguments proc))
         (required-params (assoc-ref parameters 'required))
         (optional-params (assoc-ref parameters 'optional))
         (keyword-params (assoc-ref parameters 'keyword))
         (rest-param (assoc-ref parameters 'rest))]

    `(arguments
      ,(string-join
        (append
         (map symbol->string required-params)
         (if (null? optional-params)
             (list)
             (cons "#:opt" (map symbol->string optional-params)))
         (if (null? keyword-params)
             (list)
             (cons "#:key" (map symbol->string keyword-params)))
         (if rest-param
             (list "." (symbol->string rest-param))
             (list)))
        " "))))



;;; HELPERS
(define (get-field record field)
  "Get the value of FIELD from RECORD.

  RECORD (Guile record or SRFI 9 record)
    A record of any type.

  FIELD (symbol)
    The name of the field.

  RETURN VALUE (anything)
    The value of the field.

  If the FIELD does not exist, a no-such-field exception is raised."
  (let* [(descriptor (record-type-descriptor record))
         (access-field (record-accessor descriptor field))]

    (access-field record)))
