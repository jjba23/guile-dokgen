# guile-documenta --- editor configuration
#
# EditorConfig is understood by Emacs (editorconfig-mode), VS Code, Vim,
# Neovim, IntelliJ and others, which makes it the cheapest way to say the
# things the code cannot: the encoding, the line endings and the final newline.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.scm]
indent_size = 2
max_line_length = 96

[*.{yaml,yml}]
indent_size = 2
