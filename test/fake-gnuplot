#!/bin/sh
# guile-dokgen --- a stand-in for gnuplot, for the test suites.
#
# SPDX-License-Identifier: MIT
# Copyright © Josep Bigorra <jjbigorra@gmail.com>
#
# The suites need to watch dokgen render a plot without depending on the
# renderer a user happens to have.  This one is called the way gnuplot is:
# the script dokgen wrote and the path to write, with no extension.  It writes
# the script back inside an SVG, so a test can tell one plot from another.
#
# Usage: sh fake-gnuplot SCRIPT.gp OUTPUT-WITHOUT-EXTENSION

set -eu

test -r "$1" || { echo "no such script: $1" >&2; exit 1; }

{
    printf '<svg xmlns="http://www.w3.org/2000/svg"><text>'
    cat "$1"
    printf '</text></svg>\n'
} > "$2.svg"
