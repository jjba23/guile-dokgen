@c %end of fragment

@c %start of fragment

@anchor{dokgen_stats_git-log}
@deffn Procedure git-log directory
Return the history of @var{directory} as git prints it, or
@code{#false}.

@strong{directory} (string): A path inside a repository; git finds the
repository above it.

@strong{Return value} (string or @code{#false}): What @command{git log}
prints for the commits that touch the tree, one line per commit and one
per file it touched, or @code{#false} when git could not read one.  It
is run without a shell, so a directory is a path and not something a
shell could read.

@anchor{dk_source_dokgen_stats_git-log}
@example 
(define (git-log directory)
  "Return the history of @@var@{directory@} as git prints it, or @@code@{#false@}.

  @@strong@{directory@} (string):
    A path inside a repository; git finds the repository above it.

  @@strong@{Return value@} (string or @@code@{#false@}):
    What @@command@{git log@} prints for the commits that touch the tree, one
    line per commit and one per file it touched, or @@code@{#false@} when git
    could not read one.  It is run without a shell, so a directory is a
    path and not something a shell could read."
  (let [(port (false-if-exception
               (open-pipe* OPEN_READ "git" "-C" directory
                           "--no-pager" "log" "--no-merges" "--use-mailmap"
                           "--numstat" (format #f "--format=~a" GIT-LOG-FORMAT))))]
    (if (not port)
        #false
        (let [(text (get-string-all port))]
          (and (zero? (close-pipe port)) text)))))
@end example

@end deffn


@c %end of fragment

@c %start of fragment

@anchor{dokgen_stats_git-stats}
@deffn Procedure git-stats directory
Return the numbers of the history of @var{directory}, or @code{#false}.

@strong{directory} (string): A path inside a repository.

@strong{Return value} (alist or @code{#false}): What
@code{parse-git-log} returns, or @code{#false} when the tree has no
history git can read.

@anchor{dk_source_dokgen_stats_git-stats}
@example 
(define (git-stats directory)
  "Return the numbers of the history of @@var@{directory@}, or @@code@{#false@}.

  @@strong@{directory@} (string):
    A path inside a repository.

  @@strong@{Return value@} (alist or @@code@{#false@}):
    What @@code@{parse-git-log@} returns, or @@code@{#false@} when the tree has
    no history git can read."
  (and=> (git-log directory) parse-git-log))
@end example

@end deffn


@c %end of fragment

@c %start of fragment

@anchor{dokgen_stats_parse-git-log}
@deffn Procedure parse-git-log text
Return the history in @var{text} as the numbers a report needs.

@strong{text} (string): The output @code{git-log} returns.

@strong{Return value} (alist or @code{#false}): The commits, the newest
of them, the oldest and the newest dates, and what each author and each
file cost, largest first.  @code{#false} when there is no history in
@var{text}.

@anchor{dk_source_dokgen_stats_parse-git-log}
@example 
(define (parse-git-log text)
  "Return the history in @@var@{text@} as the numbers a report needs.

  @@strong@{text@} (string):
    The output @@code@{git-log@} returns.

  @@strong@{Return value@} (alist or @@code@{#false@}):
    The commits, the newest of them, the oldest and the newest dates, and
    what each author and each file cost, largest first.  @@code@{#false@}
    when there is no history in @@var@{text@}."
  (define (cost entry) (+ (second entry) (third entry)))
  (define (largest-first entries)
    (sort entries
          (lambda (a b)
            (let [(left (cost a))
                  (right (cost b))]
              (or (> left right)
                  (and (= left right) (string<? (car a) (car b))))))))
  (let loop [(lines (lines-of text))
             (commits 0)
             (newest #false)
             (newest-date #false)
             (oldest-date #false)
             (authors '())
             (files '())
             (author #false)]
    (cond
     [(null? lines)
      (and (> commits 0)
           `((commits . ,commits)
             (commit . ,newest)
             (last . ,newest-date)
             (first . ,oldest-date)
             (authors . ,(largest-first authors))
             (files . ,(largest-first files))))]
     [(string-prefix? GIT-LOG-MARKER (first lines))
      (let* [(header (string-split
                      (substring (first lines) (string-length GIT-LOG-MARKER))
                      #\tab))
             (date (timestamp->date (string->number (third header))))]
        (loop (cdr lines) (+ commits 1)
              (if newest newest (first header))
              (if newest-date newest-date date)
              date
              authors files (second header)))]
     [(and author (numstat (first lines)))
      => (lambda (field)
           (loop (cdr lines) commits newest newest-date oldest-date
                 (bump authors author (first field) (second field))
                 (bump files (third field) (first field) (second field))
                 author))]
     [else (loop (cdr lines) commits newest newest-date oldest-date
                 authors files author)])))
@end example

@end deffn


@c %end of fragment

@c %start of fragment

@anchor{dokgen_stats_project-stats}
@deffn Procedure project-stats files
Return the totals of @var{files} and the files in the order to show
them.

@strong{files} (list of alists): What @code{analyze-file} returns for
each file of the project.

@strong{Return value} (alist): @code{files}, largest first and then by
name, and the totals of the lines, the decision points and the bytes.

@anchor{dk_source_dokgen_stats_project-stats}
@example 
(define (project-stats files)
  "Return the totals of @@var@{files@} and the files in the order to show them.

  @@strong@{files@} (list of alists):
    What @@code@{analyze-file@} returns for each file of the project.

  @@strong@{Return value@} (alist):
    @@code@{files@}, largest first and then by name, and the totals of the
    lines, the decision points and the bytes."
  (define (larger-first? a b)
    (let [(left (assoc-ref a 'code))
          (right (assoc-ref b 'code))]
      (or (> left right)
          (and (= left right)
               (string<? (assoc-ref a 'name) (assoc-ref b 'name))))))
  (let* [(sorted (sort files larger-first?))
         (total (lambda (key)
                  (reduce + 0 (map (lambda (file) (assoc-ref file key)) sorted))))]
    `((files . ,sorted)
      (blank . ,(total 'blank))
      (comment . ,(total 'comment))
      (code . ,(total 'code))
      (decisions . ,(total 'decisions))
      (bytes . ,(total 'bytes)))))
@end example

@end deffn


@c %end of fragment

@c %end of fragment

@c %end of fragment

@c %start of fragment

@node dokgen_templates_stexi
@section (dokgen templates stexi)

@c %start of fragment

This module defines procedures that structure @ref{dokgen_data,API data}
as @emph{stexi} (symbolic texinfo), which can later be translated into
Texinfo and integrated with the rest of the Texinfo documentation of a
given software project.


@c %end of fragment

@c %start of fragment

@subsection Overview
@itemize 
@item
@ref{dokgen_templates_stexi_api-binding,api-binding} — Return the API binding name-value as an stexi fragment.


@item
@ref{dokgen_templates_stexi_api-chapter,api-chapter} — Return a library API as an stexi chapter.


@item
@ref{dokgen_templates_stexi_module-description,module-description} — Return the module's commentary or description as stexi.


@item
@ref{dokgen_templates_stexi_module-overview,module-overview} — Return the module's exported objects as a list a reader can skim.


@item
@ref{dokgen_templates_stexi_module-section,module-section} — Return the module documentation as an stexi section.


@item
@ref{dokgen_templates_stexi_procedure-parameters,procedure-parameters} — Return the parameters of the given procedure as a string.


@item
@ref{dokgen_templates_stexi_stats-chapter,stats-chapter} — Return the statistics of a project as an stexi chapter.


@end itemize


@c %end of fragment

@c %start of fragment

@subsection Procedures

@c %start of fragment

@anchor{dokgen_templates_stexi_api-binding}
@deffn Procedure api-binding name value module-name
Return the API binding name-value as an stexi fragment.

@strong{name} (symbol): The name of the binding.  For example, the name
of a variable, the name of a procedure, etc.

@strong{value} (anything): Any kind of object.  For example, a string, a
list, a procedure, a record, etc.

@strong{module-name} (list of symbols): The name of the module where the
binding is defined.  For example: @code{'(mylib amodule)}.

@strong{Return value} (stexi): An stexi fragment that documents the
@var{value}.

@anchor{dk_source_dokgen_templates_stexi_api-binding}
@example 
(define (api-binding name value module-name)
  "Return the API binding name-value as an stexi fragment.

  @@strong@{name@} (symbol):
    The name of the binding. For example, the name of a variable,
    the name of a procedure, etc.

  @@strong@{value@} (anything):
    Any kind of object. For example, a string, a list, a procedure, a
    record, etc.

  @@strong@{module-name@} (list of symbols):
    The name of the module where the binding is defined. For example:
    @@code@{'(mylib amodule)@}.

  @@strong@{Return value@} (stexi):
    An stexi fragment that documents the @@var@{value@}."
  (let* [(name-string (symbol->string name))
         (anchor-id (string-append (module-id module-name)
                                   "_"
                                   name-string))
         (definition
          (cond
           [(macro? value) (macro name value)]
           ;; NOTE: Parameter detection must come before procedure
           ;; detection because parameters are ambiguous objects: they
           ;; are both parameters and procedures, and we want to render
           ;; them as the former.
           [(parameter? value) (parameter name value)]
           [(procedure? value) (procedure name value)]
           [(record-type? value) (record-type name value)]
           [(record? value) (record-variable name value)]
           [else
            (variable name value)]))]

      `(*fragment*
        (anchor (% (name ,anchor-id)))
        ;; Texinfo wants an anchor on a line of its own.
        "\n"
        ;; The source goes inside the definition, where the page keeps it
        ;; with the docstring rather than after the card.
        ,(append definition (source-stexi name module-name)))))
@end example

@end deffn


@c %end of fragment

@c %start of fragment

@anchor{dokgen_templates_stexi_api-chapter}
@deffn Procedure api-chapter module-names sections
Return a library API as an stexi chapter.

@strong{module-names} (list of lists of symbols): The modules the
chapter documents, in the order they are documented.

@strong{sections} (list of stexi): A list where every item is an stexi
section.

@strong{Return value} (stexi): A chapter documenting a library's API,
opening with a sentence about what it documents so that a reader knows
what the page is before meeting its first definition.

@anchor{dk_source_dokgen_templates_stexi_api-chapter}
@example 
(define (api-chapter module-names sections)
  "Return a library API as an stexi chapter.

  @@strong@{module-names@} (list of lists of symbols):
    The modules the chapter documents, in the order they are documented.

  @@strong@{sections@} (list of stexi):
    A list where every item is an stexi section.

  @@strong@{Return value@} (stexi):
    A chapter documenting a library's API, opening with a sentence about
    what it documents so that a reader knows what the page is before
    meeting its first definition."
  `(*fragment*
    (c (% (all "NOTE: Autogenerated documentation. Do not edit manually.")))
    (node (% (name "API")))
    (chapter "API")
    ,(api-introduction module-names sections)
    (heading "How to read this reference")
    (enumerate
     (item "Every module has a section of its own; open it in the index, or
with the menu button on a phone.\n")
     (item "A module section opens with its exported names and a one-line
summary of each.  Follow a name to its definition, where its signature, its
category and the docstring sit together.\n")
     (item "A definition can show the code it is written with: open " (code "Source")
" under the docstring to read the form the module holds, coloured like the
Scheme it is.\n")
     (item "To find a name across the whole API, press " (code "/") " and type
in the index filter.\n"))
    (heading "A generated chapter")
    (para "This chapter is generated from the source and the docstrings beside
it.  To correct a definition, change the source or its docstring and rebuild
the manual; an edit to this page is lost.")
    ,@@sections))
@end example

@end deffn


@c %end of fragment

@c %start of fragment

@anchor{dokgen_templates_stexi_module-description}
@deffn Procedure module-description module-name
Return the module's commentary or description as stexi.

@strong{module-name} (list of symbols): For example: @code{'(mylib
amodule)}.

@strong{Return value} (stexi): An stexi fragment.

@anchor{dk_source_dokgen_templates_stexi_module-description}
@example 
(define (module-description module-name)
  "Return the module's commentary or description as stexi.

  @@strong@{module-name@} (list of symbols):
    For example: @@code@{'(mylib amodule)@}.

  @@strong@{Return value@} (stexi):
    An stexi fragment."
  (let* [(commentary (module-commentary module-name))
         ;; FIXME: Ignore delimiters, capture the comment only.
         ;; Maybe "(?<=#\|\s)(.*)(?=\s\|#$)" but the ? of lookahead and
         ;; look behind makes the regex invalid in Guile...
         (comment-regex ".*#\\|\\s(.*)\\s\\|#.*$")  ; TODO: Improve regex.
         (block-commentary (string-match comment-regex commentary))
         (text (if block-commentary
                   (match:substring block-commentary 1)
                   commentary))]

    `(*fragment* ,@@(docstring->stexi text (module-id module-name)))))
@end example

@end deffn


@c %end of fragment

@c %start of fragment

@anchor{dokgen_templates_stexi_module-overview}
@deffn Procedure module-overview objects module-name
Return the module's exported objects as a list a reader can skim.

@strong{objects} (alist): The API objects grouped by kind, as
@code{group-api-objects} returns them.

@strong{module-name} (list of symbols): The module they belong to, so
that every name links to its own definition.

@strong{Return value} (stexi): An @code{@@itemize} of the names with the
sentence that documents each, which is what a reader looking for one of
them scans first.

@anchor{dk_source_dokgen_templates_stexi_module-overview}
@example 
(define (module-overview objects module-name)
  "Return the module's exported objects as a list a reader can skim.

  @@strong@{objects@} (alist):
    The API objects grouped by kind, as @@code@{group-api-objects@} returns
    them.

  @@strong@{module-name@} (list of symbols):
    The module they belong to, so that every name links to its own
    definition.

  @@strong@{Return value@} (stexi):
    An @@code@{@@@@itemize@} of the names with the sentence that documents
    each, which is what a reader looking for one of them scans first."
  (let [(entry (lambda (object)
                 `(item (ref (% (node ,(binding-id module-name (car object)))
                                (name ,(symbol->string (car object)))))
                        " \u2014 "
                        ,@@(summary-stexi (cdr object))
                        "\n")))]
    `(*fragment*
      (subsection "Overview")
      (itemize ,@@(append-map (lambda (group) (map entry (cdr group)))
                             objects)))))
@end example

@end deffn


@c %end of fragment

@c %start of fragment

@anchor{dokgen_templates_stexi_module-section}
@deffn Procedure module-section module-name
Return the module documentation as an stexi section.

@strong{module-name} (list of symbols): For example: @code{'(mylib
amodule)}.

@strong{Return value} (stexi): A section documenting a module's API.

@anchor{dk_source_dokgen_templates_stexi_module-section}
@example 
(define (module-section module-name)
  "Return the module documentation as an stexi section.

  @@strong@{module-name@} (list of symbols):
    For example: @@code@{'(mylib amodule)@}.

  @@strong@{Return value@} (stexi):
    A section documenting a module's API."
  (let* [(module-api (resolve-interface module-name))
         (grouped-api-objects (group-api-objects module-api))
         (node-name (module-id module-name))]

    `(*fragment*
      (node (% (name ,node-name)))
      (section ,(format #f "~a" module-name))
      ,(module-description module-name)
      ,(module-overview grouped-api-objects module-name)

      ,@@(map
         (lambda (group)
           (let [(kind (first group))
                 (objects (cdr group))]
             (module-subsection kind objects module-name)))
         grouped-api-objects))))
@end example

@end deffn


@c %end of fragment

@c %start of fragment

@anchor{dokgen_templates_stexi_procedure-parameters}
@deffn Procedure procedure-parameters proc
Return the parameters of the given procedure as a string.

@strong{proc} (procedure): A procedure object.

@strong{Return value} (string): A string listing the names of all the
required, optional, keyword, and rest of parameters of the procedure.
Default values for optional and keyword parameters are not included.

@anchor{dk_source_dokgen_templates_stexi_procedure-parameters}
@example 
(define (procedure-parameters proc)
  "Return the parameters of the given procedure as a string.

  @@strong@{proc@} (procedure):
    A procedure object.

  @@strong@{Return value@} (string):
    A string listing the names of all the required, optional, keyword,
    and rest of parameters of the procedure. Default values for optional
    and keyword parameters are not included."
  ;; Helper.
  (define (symbol-or-pair->string obj)
    "Return OBJ, a symbol or a pair, as it is written in source code."
    (format #f "~s" obj))
  (define (keyword->string keyword)
    "Return the name of the KEYWORD parameter, ignoring its default."
    (format #f "~a" (car keyword)))
  ;; Main body.
  (let* [(parameters (procedure-arguments proc))
         (required-params (assoc-ref parameters 'required))
         (optional-params (assoc-ref parameters 'optional))
         (keyword-params (assoc-ref parameters 'keyword))
         (arbitrary-keys? (assoc-ref parameters 'allow-other-keys?))
         (rest-param (assoc-ref parameters 'rest))]

    (string-join
     (append
      (map symbol->string required-params)
      (if (null? optional-params)
          (list)
          (cons "OPT:"
                (map symbol-or-pair->string optional-params)))
      (if (null? keyword-params)
          (list)
          (cons "KEY:" (map keyword->string keyword-params)))
      (if arbitrary-keys?
          (list "[arbitrary keys]")
          (list))
      (if rest-param
          (list "." (symbol->string rest-param))
          (list)))
     " ")))
@end example

@end deffn


@c %end of fragment

@c %start of fragment

@anchor{dokgen_templates_stexi_stats-chapter}
@deffn Procedure stats-chapter statistics
Return the statistics of a project as an stexi chapter.

@strong{statistics} (alist): What @code{(dokgen commands) stats}
measured and counted: @code{totals} from @code{(dokgen stats)
project-stats}, the @code{coverage} of the exported names, the number of
@code{modules}, and @code{git}, the history or @code{#false} when the
tree has none.

@strong{Return value} (stexi): A chapter describing the tree: its size,
where its code sits, how much of its API is documented, who wrote it and
what churns.

@anchor{dk_source_dokgen_templates_stexi_stats-chapter}
@example 
(define (stats-chapter statistics)
  "Return the statistics of a project as an stexi chapter.

  @@strong@{statistics@} (alist):
    What @@code@{(dokgen commands) stats@} measured and counted:
    @@code@{totals@} from @@code@{(dokgen stats) project-stats@}, the
    @@code@{coverage@} of the exported names, the number of @@code@{modules@},
    and @@code@{git@}, the history or @@code@{#false@} when the tree has none.

  @@strong@{Return value@} (stexi):
    A chapter describing the tree: its size, where its code sits, how much
    of its API is documented, who wrote it and what churns."
  (let* [(totals (assoc-ref statistics 'totals))
         (files (assoc-ref totals 'files))
         (coverage (assoc-ref statistics 'coverage))
         (documented (car coverage))
         (exported (cdr coverage))
         (modules (assoc-ref statistics 'modules))
         (git (assoc-ref statistics 'git))
         (churn (and git (assoc-ref git 'files)))
         (percentage
          (and (> exported 0) (* 100 (exact->inexact (/ documented exported)))))]
    `(*fragment*
      (c (% (all "NOTE: Autogenerated documentation. Do not edit manually.")))
      (node (% (name "Statistics")))
      (chapter "Statistics")
      (para "This chapter is written by " (command "dokgen stats")
            " from the tree itself, so it says what the code is rather than
what someone remembers it to be.")
      ,@@(if git
            `((para "It describes the tree at commit "
                    (code ,(assoc-ref git 'commit)) ", on "
                    ,(assoc-ref git 'last) "."))
            '((para "The tree carries no git history this run could read, so
the chapter reports no authors and no churn.")))

      (section "Size")
      (example ,(size-table totals files modules))

      (section "The largest files")
      (para "The files with the most code in them, with the lines of comment
and the decision points that sit beside it.")
      (example ,(file-table files))

      (section "Documentation")
      (para ,(if percentage
                 (format #f "~a of the ~a exported procedures and macros have a documentation string (~a%)."
                         documented exported (inexact->exact (round percentage)))
                 "The tree exports no procedure or macro, so there is nothing to document."))

      ,@@(if (and git (pair? churn))
            `((section "Authors")
              (para "The people the repository's history names, with the
lines they added and removed.")
              (example ,(cost-table (assoc-ref git 'authors)))

              (section "The files that change most")
              (para "The files among those measured that the history touched
most: the ones where a change costs the most to review.")
              (example ,(cost-table (at-most 10 churn)))

              (para "The repository holds "
                    ,(number->string (assoc-ref git 'commits))
                    " commits, the first on "
                    ,(assoc-ref git 'first) "."))
            '())

      (para "A decision point is an " (code "if") ", " (code "cond") ", "
            (code "case") ", " (code "when") ", " (code "unless") " or "
            (code "do") " in the code.  It counts shapes and not paths, and
it grades nothing: a file with many of them is a file that branches
often."))))
@end example

@end deffn


@c %end of fragment

@c %end of fragment

@c %end of fragment

@c %start of fragment

@node dokgen_utils
@section (dokgen utils)

@c %start of fragment

This module defines helper procedures that didn't quite fit anywhere
else.  They normalize the indentation of documentation strings before
they are rendered.  The constant @code{DEFAULT_SPACE_INDENT_SIZE} is the
number of spaces that replace a tab when no other size is given; its
value is 2.


@c %end of fragment

@c %start of fragment

@subsection Overview
@itemize 
@item
@ref{dokgen_utils_min-indent,min-indent} — Return the shorter number of spaces used for indentation in the given


@item
@ref{dokgen_utils_tabs->spaces,tabs->spaces} — Convert tabs to spaces in the given string.


@item
@ref{dokgen_utils_trim,trim} — Trim off the given number of spaces at the beginning of the string.


@item
@ref{dokgen_utils_unindent,unindent} — Remove unwanted indentation from the given documentation string.


@item
@ref{dokgen_utils_DEFAULT_SPACE_INDENT_SIZE,DEFAULT_SPACE_INDENT_SIZE} — A variable.


@end itemize


@c %end of fragment

@c %start of fragment

@subsection Procedures

@c %start of fragment

@anchor{dokgen_utils_min-indent}
@deffn Procedure min-indent string
Return the shorter number of spaces used for indentation in the given
string.

This procedure assumes indentation is space-based, not tab-based.

@strong{string} (string): The text to inspect.

@strong{Return value} (integer): The number of spaces representing the
shorter indentation.

@anchor{dk_source_dokgen_utils_min-indent}
@example 
(define (min-indent string)
  "Return the shorter number of spaces used for indentation in the given
  string.

  This procedure assumes indentation is space-based, not tab-based.

  @@strong@{string@} (string):
    The text to inspect.

  @@strong@{Return value@} (integer):
    The number of spaces representing the shorter indentation."
  (if (or (string-null? string) (not (string-contains string "\n")))
      0
      (let [(target-lines (cdr (string-split string #\newline)))]
        ;; Target lines omit the first line (never indented). Otherwise,
        ;; the procedure would always return zero.
        (fold
         (lambda (line result-so-far)
           (if (string-null? line)
               result-so-far
               (min result-so-far
                    (- (string-length line) (string-length (string-trim line))))))
         9999           ; Arbitrary big min-indent to start comparing.
         target-lines))))
@end example

@end deffn


@c %end of fragment

@c %start of fragment

@anchor{dokgen_utils_tabs->spaces}
@deffn Procedure tabs->spaces string OPT: tabsize
Convert tabs to spaces in the given string.

@strong{string} (string): The original text.

@strong{tabsize} (integer): Optional.  The number of spaces that will
replace a single tab.  If not provided, @var{DEFAULT_SPACE_INDENT_SIZE}
is used.

@strong{Return value} (string): A new string where all tabs are replaced
by spaces.

@anchor{dk_source_dokgen_utils_tabs->spaces}
@example 
(define* (tabs->spaces string #:optional (tabsize DEFAULT_SPACE_INDENT_SIZE))
  "Convert tabs to spaces in the given string.

  @@strong@{string@} (string):
    The original text.

  @@strong@{tabsize@} (integer):
    Optional. The number of spaces that will replace a single tab.
    If not provided, @@var@{DEFAULT_SPACE_INDENT_SIZE@} is used.

  @@strong@{Return value@} (string):
    A new string where all tabs are replaced by spaces."
  (string-concatenate
   (map
    (lambda (character)
      (if (char=? character #\tab)
          (make-string tabsize #\space)
          (make-string 1 character)))
    (string->list string))))
@end example

@end deffn


@c %end of fragment

@c %start of fragment

@anchor{dokgen_utils_trim}
@deffn Procedure trim string spaces
Trim off the given number of spaces at the beginning of the string.

@strong{string} (string): The original text.

@strong{spaces} (integer): The number of spaces to trim off.

@strong{Return value} (string): A new string with the exact number of
spaces removed, if they exist.  Otherwise, the original string is
returned.

@anchor{dk_source_dokgen_utils_trim}
@example 
(define (trim string spaces)
  "Trim off the given number of spaces at the beginning of the string.

  @@strong@{string@} (string):
    The original text.

  @@strong@{spaces@} (integer):
    The number of spaces to trim off.

  @@strong@{Return value@} (string):
    A new string with the exact number of spaces removed, if they exist.
    Otherwise, the original string is returned."
  (let [(indent (make-string spaces #\space))]

    (if (string-prefix? indent string)
        (string-drop string spaces)
        string)))
@end example

@end deffn


@c %end of fragment

@c %start of fragment

@anchor{dokgen_utils_unindent}
@deffn Procedure unindent docstring
Remove unwanted indentation from the given documentation string.

'Unwanted' indentation is what results, for example, from aligning
documentation lines to the first line of the documentation string so
that they look aesthetic in the source code.

@strong{docstring} (string): A string that documents a procedure or any
other object.

@strong{Return value} (string): A new string with the undesired
indentation removed.

@anchor{dk_source_dokgen_utils_unindent}
@example 
(define (unindent docstring)
  "Remove unwanted indentation from the given documentation string.

  'Unwanted' indentation is what results, for example, from aligning
  documentation lines to the first line of the documentation string so
  that they look aesthetic in the source code.

  @@strong@{docstring@} (string):
    A string that documents a procedure or any other object.

  @@strong@{Return value@} (string):
    A new string with the undesired indentation removed."
  (let* [(untabbed-docstring (tabs->spaces docstring))
         (min-indent (min-indent untabbed-docstring))
         (lines (string-split untabbed-docstring #\newline))
         ;; Remove 1st level indents, if any.
         (lines-trimmed
          (map
           (lambda (line) (trim line min-indent))
           lines))]

    (string-join lines-trimmed "\n")))
@end example

@end deffn


@c %end of fragment

@c %end of fragment

@c %start of fragment

@subsection Variables

@c %start of fragment

@anchor{dokgen_utils_DEFAULT_SPACE_INDENT_SIZE}
@defvr Variable DEFAULT_SPACE_INDENT_SIZE
@verbatim 
2
@end verbatim

@anchor{dk_source_dokgen_utils_DEFAULT_SPACE_INDENT_SIZE}
@example 
(see tabs->spaces).
(define DEFAULT_SPACE_INDENT_SIZE 2)
@end example

@end defvr


@c %end of fragment

@c %end of fragment

@c %end of fragment

