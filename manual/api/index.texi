@c %start of fragment

@anchor{dokgen_cli_spec}
@defvar spec
This is a record of the type @code{<configuration>}, with 18 fields:
@code{name}, @code{synopsis}, @code{description}, @code{wanted},
@code{keywords}, @code{arguments}, @code{subcommands}, @code{directory},
@code{version}, @code{license}, @code{copyright}, @code{author},
@code{parser}, @code{alias}, @code{generate-help?},
@code{generate-usage?}, @code{generate-version?},
@code{generate-cmdtree?}.

@anchor{dk_source_dokgen_cli_spec}
@example 
(define spec
  (configuration
   (name 'dokgen)
   (synopsis "Generate API documentation.")
   (description
    "This is the command-line interface of Guile Dokgen, a software to generate API documentation for GNU Guile Scheme projects.")
   (version "0.12.0")
   (license expat)
   (author "Josep Bigorra")

   (subcommands
    (list
     (configuration
      (name 'api)
      (synopsis "Extract the API documentation of the given Guile Scheme package or module.")
      (arguments (list sources))
      (keywords (list destination mermaid-command gnuplot-command)))

     (configuration
      (name 'check)
      (synopsis "Report the exported procedures and macros that have no documentation string.")
      (arguments (list sources)))

     (configuration
      (name 'stats)
      (synopsis "Measure the sources: lines, decision points, authors and churn.")
      (arguments (list sources))
      (keywords (list destination)))))))
@end example

@end defvar


