"/* dokgen.css --- the presentation of an API chapter.\n *\n * SPDX-License-Identifier: MIT\n * Copyright © Josep Bigorra <jjbigorra@@gmail.com>\n *\n * dokgen writes this file beside the Texinfo chapter it generates.  Its\n * stylesheet turns what texi2any emits into what a reader of modern\n * reference documentation expects: a card per definition, the signature\n * of each one readable at a glance, an index of them down the side, and\n * diagrams that open into something they can zoom into.\n *\n * Nothing here is required: the chapter is complete Texinfo without it,\n * and Info and print output never see a line of it.  It is written for\n * the HTML readers, and every rule is either a `dk-` class that the\n * script adds or a selector texi2any is known to emit.\n */\n\n:root @{\n    --dk-fg: #1b1b1f;\n    --dk-muted: #5f5f6b;\n    --dk-card: #fbfbfd;\n    --dk-signature: #f2f2f7;\n    --dk-border: #dcdce6;\n    --dk-accent: #a8480c;\n    --dk-accent-soft: rgba(168, 72, 12, 0.12);\n    --dk-radius: 10px;\n    --dk-shadow: 0 1px 2px rgba(16, 16, 24, 0.06), 0 4px 14px rgba(16, 16, 24, 0.05);\n    --dk-mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace;\n@}\n\n@@media (prefers-color-scheme: dark) @{\n    :root @{\n        --dk-fg: #e9e9ef;\n        --dk-muted: #a3a3b0;\n        --dk-card: #1b1b20;\n        --dk-signature: #232329;\n        --dk-border: #2f2f38;\n        --dk-accent: #ffa066;\n        --dk-accent-soft: rgba(255, 160, 102, 0.14);\n        --dk-shadow: 0 1px 2px rgba(0, 0, 0, 0.5), 0 4px 14px rgba(0, 0, 0, 0.35);\n    @}\n@}\n\n[data-dk-theme=\"light\"] @{\n    --dk-fg: #1b1b1f;\n    --dk-muted: #5f5f6b;\n    --dk-card: #fbfbfd;\n    --dk-signature: #f2f2f7;\n    --dk-border: #dcdce6;\n    --dk-accent: #a8480c;\n    --dk-accent-soft: rgba(168, 72, 12, 0.12);\n    --dk-shadow: 0 1px 2px rgba(16, 16, 24, 0.06), 0 4px 14px rgba(16, 16, 24, 0.05);\n@}\n\n[data-dk-theme=\"dark\"] @{\n    --dk-fg: #e9e9ef;\n    --dk-muted: #a3a3b0;\n    --dk-card: #1b1b20;\n    --dk-signature: #232329;\n    --dk-border: #2f2f38;\n    --dk-accent: #ffa066;\n    --dk-accent-soft: rgba(255, 160, 102, 0.14);\n    --dk-shadow: 0 1px 2px rgba(0, 0, 0, 0.5), 0 4px 14px rgba(0, 0, 0, 0.35);\n@}\n\nhtml @{\n    scroll-behavior: smooth;\n@}\n\n@@media (prefers-reduced-motion: reduce) @{\n    html @{\n        scroll-behavior: auto;\n    @}\n@}\n\n/* One card per definition, which is the unit a reader comes for. */\n\ndl.def-block @{\n    position: relative;\n    margin: 1.3rem 0;\n    padding: 0.85rem 1.1rem 1rem;\n    background: var(--dk-card);\n    border: 1px solid var(--dk-border);\n    border-left: 3px solid var(--dk-accent);\n    border-radius: var(--dk-radius);\n    box-shadow: var(--dk-shadow);\n    transition: box-shadow 0.15s ease, border-color 0.15s ease;\n@}\n\ndl.def-block:hover @{\n    box-shadow: 0 2px 4px rgba(16, 16, 24, 0.08), 0 10px 28px rgba(16, 16, 24, 0.08);\n@}\n\ndl.def-block:target @{\n    border-color: var(--dk-accent);\n    box-shadow: 0 0 0 3px var(--dk-accent-soft);\n@}\n\ndl.def-block > dt.def-line @{\n    display: flex;\n    flex-wrap: wrap;\n    align-items: baseline;\n    gap: 0.5rem;\n    margin: 0 0 0.6rem;\n    padding: 0.5rem 0.65rem;\n    background: var(--dk-signature);\n    border-radius: calc(var(--dk-radius) - 4px);\n    font-family: var(--dk-mono);\n    font-size: 1rem;\n@}\n\ndl.def-block .category-def @{\n    font-family: system-ui, sans-serif;\n    font-size: 0.68rem;\n    font-weight: 600;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n    color: var(--dk-accent);\n    background: var(--dk-accent-soft);\n    border-radius: 999px;\n    padding: 0.18rem 0.55rem;\n@}\n\ndl.def-block .def-name @{\n    font-size: 1.06rem;\n    font-weight: 700;\n@}\n\ndl.def-block .def-var-arguments,\ndl.def-block .def-type @{\n    color: var(--dk-muted);\n    font-weight: 400;\n@}\n\ndl.def-block > dd @{\n    margin: 0;\n@}\n\ndl.def-block > dd > p:first-child @{\n    font-size: 1.03rem;\n@}\n\ndl.def-block > dd > p @{\n    max-width: 78ch;\n@}\n\n/* The paragraph that says what a parameter is reads as a definition. */\n\ndl.def-block > dd strong.strong @{\n    color: var(--dk-fg);\n@}\n\n/* What the script adds: a copy button, a folding tail, an index pane. */\n\n.dk-copy @{\n    margin-left: auto;\n    font: 500 0.72rem/1 system-ui, sans-serif;\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n    color: var(--dk-muted);\n    background: transparent;\n    border: 1px solid var(--dk-border);\n    border-radius: 6px;\n    padding: 0.3rem 0.5rem;\n    cursor: pointer;\n    opacity: 0;\n    transition: opacity 0.15s ease, color 0.15s ease, border-color 0.15s ease;\n@}\n\ndl.def-block:hover .dk-copy,\n.dk-copy:focus-visible @{\n    opacity: 1;\n@}\n\n.dk-copy:hover @{\n    color: var(--dk-accent);\n    border-color: var(--dk-accent);\n@}\n\n.dk-copy[data-dk-copied=\"yes\"] @{\n    color: var(--dk-accent);\n    border-color: var(--dk-accent);\n    opacity: 1;\n@}\n\ndetails.dk-more @{\n    margin-top: 0.6rem;\n@}\n\ndetails.dk-more > summary @{\n    cursor: pointer;\n    font: 500 0.82rem/1.4 system-ui, sans-serif;\n    color: var(--dk-accent);\n    list-style: none;\n@}\n\ndetails.dk-more > summary::-webkit-details-marker @{\n    display: none;\n@}\n\ndetails.dk-more > summary::before @{\n    content: \"▸ \";\n@}\n\ndetails.dk-more[open] > summary::before @{\n    content: \"▾ \";\n@}\n\nnav.dk-index @{\n    position: fixed;\n    inset: 0 auto 0 0;\n    width: 270px;\n    padding: 1.1rem 0.9rem 2rem;\n    overflow-y: auto;\n    background: var(--dk-card);\n    border-right: 1px solid var(--dk-border);\n    font: 0.86rem/1.45 system-ui, sans-serif;\n    z-index: 20;\n@}\n\nbody.dk-has-index @{\n    margin-left: 270px;\n@}\n\nnav.dk-index h2 @{\n    margin: 0 0 0.6rem;\n    font-size: 0.72rem;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: var(--dk-muted);\n@}\n\nnav.dk-index input @{\n    width: 100%;\n    box-sizing: border-box;\n    margin-bottom: 0.7rem;\n    padding: 0.4rem 0.55rem;\n    color: inherit;\n    background: var(--dk-signature);\n    border: 1px solid var(--dk-border);\n    border-radius: 6px;\n    font: inherit;\n@}\n\nnav.dk-index input:focus-visible @{\n    outline: 2px solid var(--dk-accent);\n    outline-offset: 1px;\n@}\n\nnav.dk-index ul @{\n    margin: 0;\n    padding: 0;\n    list-style: none;\n@}\n\nnav.dk-index li @{\n    margin: 0;\n@}\n\nnav.dk-index a @{\n    display: block;\n    padding: 0.28rem 0.45rem;\n    color: var(--dk-fg);\n    text-decoration: none;\n    border-radius: 6px;\n    border-left: 2px solid transparent;\n    font-family: var(--dk-mono);\n    font-size: 0.84rem;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n@}\n\nnav.dk-index a:hover @{\n    background: var(--dk-accent-soft);\n@}\n\nnav.dk-index a[aria-current=\"true\"] @{\n    color: var(--dk-accent);\n    border-left-color: var(--dk-accent);\n    background: var(--dk-accent-soft);\n@}\n\nnav.dk-index .dk-kind @{\n    color: var(--dk-muted);\n    font: 0.66rem/1 system-ui, sans-serif;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n    margin-right: 0.35rem;\n@}\n\n@@media (max-width: 1080px) @{\n    nav.dk-index @{\n        position: static;\n        width: auto;\n        margin: 0 0 1rem;\n        border-right: 0;\n        border-bottom: 1px solid var(--dk-border);\n    @}\n\n    body.dk-has-index @{\n        margin-left: 0;\n    @}\n@}\n\n/* Diagrams: the image is the content, so it scales and it opens. */\n\nimg.image @{\n    display: block;\n    max-width: 100%;\n    height: auto;\n    margin: 1rem auto;\n    padding: 0.5rem;\n    background: #ffffff;\n    border: 1px solid var(--dk-border);\n    border-radius: var(--dk-radius);\n    cursor: zoom-in;\n@}\n\n.dk-lightbox @{\n    position: fixed;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: rgba(8, 8, 12, 0.86);\n    z-index: 50;\n@}\n\n.dk-lightbox img @{\n    max-width: 92vw;\n    max-height: 92vh;\n    width: auto;\n    height: auto;\n    cursor: grab;\n    transform-origin: center center;\n    transition: transform 0.05s linear;\n    background: #ffffff;\n    border-radius: 4px;\n    padding: 0.6rem;\n@}\n\n.dk-lightbox .dk-zoom @{\n    position: absolute;\n    top: 1rem;\n    right: 1rem;\n    display: flex;\n    gap: 0.4rem;\n@}\n\n.dk-lightbox button @{\n    font: 600 0.9rem/1 system-ui, sans-serif;\n    min-width: 2.4rem;\n    padding: 0.55rem 0.7rem;\n    color: #f4f4f8;\n    background: rgba(255, 255, 255, 0.12);\n    border: 1px solid rgba(255, 255, 255, 0.25);\n    border-radius: 8px;\n    cursor: pointer;\n@}\n\n.dk-lightbox button:hover @{\n    background: rgba(255, 255, 255, 0.22);\n@}\n\n@@media print @{\n    nav.dk-index,\n    .dk-copy,\n    .dk-lightbox @{\n        display: none !important;\n    @}\n\n    body.dk-has-index @{\n        margin-left: 0;\n    @}\n\n    dl.def-block @{\n        box-shadow: none;\n        break-inside: avoid;\n    @}\n@}\n"
@end verbatim

