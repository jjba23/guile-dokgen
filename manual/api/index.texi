    margin-top: 0;
@}

body.dk-has-index h3.section @{
    margin: 2.6rem 0 0.9rem;
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
@}

body.dk-has-index h3.heading @{
    margin: 2.4rem 0 0.8rem;
    font-size: clamp(1.3rem, 1.8vw, 1.5rem);
@}

body.dk-has-index h4.subsection @{
    margin: 2.1rem 0 0.7rem;
    font-size: 1.25rem;
@}

/* The reading guide on a chapter landing page: a short numbered list in
   a card, not another copy of the index. */

body.dk-has-index h3.heading + ol.enumerate @{
    margin: 1rem 0 1.8rem;
    padding: 1.1rem 1.35rem 1.1rem 2.6rem;
    background: var(--dk-card);
    border: 1px solid var(--dk-border);
    border-radius: var(--dk-radius);
@}

body.dk-has-index h3.heading + ol.enumerate li @{
    margin: 0.45rem 0;
@}

body.dk-has-index h3.heading + ol.enumerate li::marker @{
    color: var(--dk-accent);
    font-weight: 650;
@}

body.dk-has-index a @{
    color: var(--dk-accent-strong);
    text-decoration-color: color-mix(in srgb, var(--dk-accent) 40%, transparent);
    text-underline-offset: 0.18em;
@}

body.dk-has-index a:hover @{
    color: var(--dk-accent);
@}

body.dk-has-index p @{
    max-width: 74ch;
@}

/* The sentence that says what the chapter is. */

h1.top + p,
h2.chapter + p @{
    max-width: 64ch;
    margin: 0 0 2.4rem;
    padding-bottom: 1.7rem;
    border-bottom: 1px solid var(--dk-border);
    color: var(--dk-muted);
    font-family: var(--dk-serif);
    font-size: clamp(1.12rem, 1.5vw, 1.3rem);
    line-height: 1.62;
@}

/* The one index replaces the list texi2any writes into the body.  It is
   hidden only after the script has built its own, so a reader without
   JavaScript keeps a table of contents. */

body.dk-has-index ul.mini-toc @{
    display: none;
@}

/* The manual's title is in the bar above every page; on the page that
   carries it, it does not need a second heading of its own. */
body.dk-has-index h1.settitle @{
    display: none;
@}

body.dk-has-index h1.settitle + hr @{
    display: none;
@}

/* A single-page manual repeats Next/Previous/Up before every section;
   with the index down the side those rows only get in the way.  A split
   manual keeps them, because they carry the Contents and Index links. */

body.dk-flat .nav-panel,
body.dk-flat .nav-panel + hr @{
    display: none;
@}

/* On a single page the index holds the whole manual, so the body's own
   table of contents would be the second copy of it. */

body.dk-flat .region-contents#SEC_Contents @{
    display: none;
@}

.nav-panel @{
    max-width: 100%;
    color: var(--dk-muted);
    font: 0.78rem/1.6 var(--dk-sans);
@}

body.dk-has-index .nav-panel a @{
    color: var(--dk-muted);
    font-weight: 400;
    text-decoration: none;
    border-bottom: 1px dotted var(--dk-border);
@}

body.dk-has-index .nav-panel a:hover @{
    color: var(--dk-accent-strong);
    border-bottom-color: currentColor;
@}

hr @{
    border: 0;
    border-top: 1px solid var(--dk-border);
    margin: 1.8rem 0;
@}

/* --- code and examples ---------------------------------------------- */

body.dk-has-index code,
body.dk-has-index kbd,
body.dk-has-index samp,
body.dk-has-index var @{
    font-family: var(--dk-mono);
    font-size: 0.9em;
@}

body.dk-has-index :not(pre) > code @{
    padding: 0.08em 0.32em;
    color: var(--dk-fg);
    background: var(--dk-code);
    border: 1px solid var(--dk-border);
    border-radius: 4px;
@}

body.dk-has-index div.example,
body.dk-has-index pre,
body.dk-has-index pre.example,
body.dk-has-index pre.verbatim @{
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: auto;
@}

body.dk-has-index div.example @{
    margin: 1rem 0;
    padding: 0.85rem 1rem;
    background: var(--dk-code);
    border: 1px solid var(--dk-border);
    border-radius: 6px;
@}

body.dk-has-index div.example pre @{
    margin: 0;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 0;
@}

body.dk-has-index pre @{
    margin: 1rem 0;
    padding: 0.8rem 1rem;
    color: var(--dk-fg);
    background: var(--dk-signature);
    border: 1px solid var(--dk-border);
    border-radius: 6px;
    box-shadow: none;
    font-size: 0.86rem;
    line-height: 1.6;
@}

/* --- lists and tables ----------------------------------------------- */

body.dk-has-index ul,
body.dk-has-index ol @{
    padding-left: 1.2rem;
@}

body.dk-has-index li @{
    margin: 0.24rem 0;
@}

body.dk-has-index li::marker @{
    color: var(--dk-muted);
@}

body.dk-has-index table @{
    width: 100%;
    margin: 1.1rem 0;
    border-collapse: collapse;
    font-size: 0.9rem;
@}

body.dk-has-index th,
body.dk-has-index td @{
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid var(--dk-border);
    text-align: left;
    vertical-align: top;
@}

body.dk-has-index th @{
    color: var(--dk-muted);
    font-family: var(--dk-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
@}

body.dk-has-index blockquote @{
    margin: 1.2rem 0;
    padding: 0.1rem 0 0.1rem 1rem;
    border-left: 2px solid var(--dk-border);
    color: var(--dk-muted);
@}

/* --- the bar -------------------------------------------------------- */

.dk-skip @{
    position: absolute;
    left: -9999px;
    z-index: 60;
    padding: 0.55rem 0.9rem;
    color: var(--dk-fg);
    background: var(--dk-card);
    border: 1px solid var(--dk-accent);
    border-radius: 6px;
@}

.dk-skip:focus @{
    left: 0.6rem;
    top: 0.6rem;
@}

.dk-bar @{
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 calc(-1 * clamp(1.1rem, 3vw, 2.8rem));
    padding: 0.5rem clamp(1.1rem, 3vw, 2.8rem);
    background: var(--dk-bg);
    border-bottom: 1px solid var(--dk-border);
@}

@@supports (backdrop-filter: blur(1px)) @{
    .dk-bar @{
        background: color-mix(in srgb, var(--dk-bg) 74%, transparent);
        -webkit-backdrop-filter: blur(var(--dk-blur)) saturate(130%);
        backdrop-filter: blur(var(--dk-blur)) saturate(130%);
    @}
@}

.dk-bar-title @{
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: var(--dk-fg);
    font-family: var(--dk-serif);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
@}

.dk-icon @{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    min-width: 2.15rem;
    height: 2.15rem;
    padding: 0 0.45rem;
    color: var(--dk-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    font: 500 0.95rem/1 var(--dk-sans);
    cursor: pointer;
@}

.dk-icon:hover @{
    color: var(--dk-accent-strong);
    background: var(--dk-accent-soft);
@}

.dk-menu @{
    display: none;
@}

.dk-top[hidden] @{
    display: none;
@}

.dk-scrim @{
    display: none;
@}

/* --- the index ------------------------------------------------------ */

.dk-index @{
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    width: var(--dk-sidebar);
    overflow: hidden;
    background: var(--dk-card);
    border-right: 1px solid var(--dk-border);
    font: 0.85rem/1.5 var(--dk-sans);
@}

.dk-index-head @{
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1.1rem 1rem 0.55rem;
@}

.dk-index-head h2 @{
    flex: 1;
    margin: 0;
    color: var(--dk-muted);
    font-family: var(--dk-sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
@}

.dk-index-close @{
    display: none;
@}

.dk-index-filter @{
    display: block;
    width: calc(100% - 2rem);
    margin: 0 1rem 0.8rem;
    padding: 0.42rem 0.6rem;
    color: var(--dk-fg);
    background: var(--dk-signature);
    border: 1px solid var(--dk-border);
    border-radius: 6px;
    font: inherit;
    font-size: 0.9rem;
@}

.dk-index-scroll @{
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 0.6rem 1.5rem;
    /* Its own surface, so a page stylesheet's link decoration cannot
       show through the rows of the index. */
    background: var(--dk-card);
    scrollbar-color: var(--dk-border) transparent;
@}

.dk-index-scroll::-webkit-scrollbar @{
    width: 8px;
@}

.dk-index-scroll::-webkit-scrollbar-thumb @{
    background: var(--dk-border);
    border-radius: 999px;
@}

.dk-index-scroll::-webkit-scrollbar-track @{
    background: transparent;
@}

.dk-index-empty @{
    margin: 0.8rem 0.5rem 0;
    color: var(--dk-muted);
    font-size: 0.8rem;
@}

.dk-nav,
.dk-nav ul @{
    margin: 0;
    padding: 0;
    list-style: none;
@}

.dk-nav ul @{
    margin: 0.1rem 0 0.35rem 0.55rem;
    padding-left: 0.3rem;
    border-left: 1px solid var(--dk-border);
@}

.dk-nav [hidden] @{
    display: none;
@}

.dk-row @{
    display: flex;
    align-items: center;
    gap: 0.05rem;
    border-radius: 5px;
@}

.dk-row > a @{
    flex: 1;
    min-width: 0;
    padding: 0.28rem 0.45rem;
    color: var(--dk-fg);
    text-decoration: none;
    /* The site stylesheet underlines every link; a row of the index is
       read as a list, so its underline is the surface it sits on. */
    border-bottom: 0;
    box-shadow: none;
    border-radius: 5px;
@}

.dk-group > .dk-row > a @{
    font-family: var(--dk-serif);
    font-size: 0.92rem;
    font-weight: 600;
@}

.dk-nav ul .dk-group > .dk-row > a @{
    font-family: var(--dk-sans);
    font-size: 0.81rem;
    font-weight: 500;
    color: var(--dk-muted);
@}

.dk-row > a:hover @{
    background: var(--dk-accent-soft);
@}

.dk-row > a[aria-current=\"location\"] @{
    color: var(--dk-accent-strong);
    background: var(--dk-accent-soft);
@}

.dk-toggle @{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    color: var(--dk-muted);
    background: transparent;
    border: 0;
    border-radius: 4px;
    cursor: pointer;
@}

.dk-toggle::before @{
    content: \"▸\";
    font-size: 0.66rem;
    transition: transform 0.15s ease;
@}

.dk-toggle[aria-expanded=\"true\"]::before @{
    transform: rotate(90deg);
@}

.dk-toggle-empty @{
    visibility: hidden;
@}

.dk-def-link @{
    display: block;
    padding: 0.24rem 0.45rem;
    color: var(--dk-fg);
    font-family: var(--dk-mono);
    font-size: 0.74rem;
    overflow-wrap: anywhere;
    text-decoration: none;
    border-bottom: 0;
    box-shadow: none;
    border-radius: 5px;
@}

.dk-def-link:hover @{
    background: var(--dk-accent-soft);
@}

.dk-def-link[aria-current=\"location\"] @{
    color: var(--dk-accent-strong);
    background: var(--dk-accent-soft);
@}

.dk-kind @{
    display: inline-block;
    margin-right: 0.35rem;
    color: var(--dk-muted);
    font-family: var(--dk-sans);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 0.08em;
@}

/* --- a definition --------------------------------------------------- */

dl.def-block @{
    position: relative;
    margin: 1.1rem 0;
    padding: 0.9rem 1.1rem 1rem;
    background: var(--dk-card);
    border: 1px solid var(--dk-border);
    border-left: 3px solid var(--dk-accent);
    border-radius: var(--dk-radius);
@}

dl.def-block:target @{
    border-color: var(--dk-accent);
    box-shadow: 0 0 0 3px var(--dk-accent-soft);
@}

dl.def-block > dt.def-line @{
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
    margin: 0 0 0.65rem;
    padding: 0.5rem 0.7rem;
    overflow-wrap: anywhere;
    background: var(--dk-signature);
    border-radius: 5px;
    font-family: var(--dk-mono);
    font-size: 0.95rem;
@}

dl.def-block .category-def @{
    padding: 0.16rem 0.5rem;
    color: var(--dk-accent-strong);
    background: var(--dk-accent-soft);
    border-radius: 999px;
    font-family: var(--dk-sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
@}

dl.def-block .def-name @{
    color: var(--dk-fg);
    font-family: var(--dk-mono);
    font-size: 1.02rem;
    font-style: normal;
    font-weight: 600;
@}

dl.def-block .def-var-arguments,
dl.def-block .def-type @{
    color: var(--dk-muted);
    font-family: var(--dk-mono);
    font-style: normal;
    font-weight: 400;
@}

dl.def-block > dd @{
    margin: 0;
@}

dl.def-block > dd > p @{
    max-width: 78ch;
@}

dl.def-block > dd > p:first-child @{
    font-size: 1.02rem;
@}

dl.def-block > dd strong.strong @{
    color: var(--dk-fg);
@}

/* --- what the script adds ------------------------------------------- */

.dk-copy @{
    margin-left: auto;
    padding: 0.28rem 0.45rem;
    color: var(--dk-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    font: 500 0.68rem/1 var(--dk-sans);
    letter-spacing: 0.02em;
    cursor: pointer;
@}

.dk-copy:hover @{
    color: var(--dk-accent-strong);
    background: var(--dk-accent-soft);
@}

.dk-copy[data-dk-copied=\"yes\"] @{
    color: var(--dk-accent-strong);
    background: var(--dk-accent-soft);
@}

/* --- the source of a definition ------------------------------------- */

/* The script folds the example the chapter marks into this panel, so the
   code behind a definition is a click away instead of a page of it.  A
   reader without the script gets the example as the chapter wrote it. */

details.dk-source @{
    margin-top: 0.8rem;
    border-top: 1px solid var(--dk-border);
@}

details.dk-source > summary @{
    margin: 0.55rem 0 0;
    padding: 0.15rem 0 0.15rem 0.15rem;
    color: var(--dk-muted);
    font-family: var(--dk-sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    cursor: pointer;
@}

details.dk-source > summary::marker @{
    color: var(--dk-accent);
@}

details.dk-source > summary:hover,
details.dk-source[open] > summary @{
    color: var(--dk-accent-strong);
@}

details.dk-source > div.example @{
    margin: 0.5rem 0 0;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 0;
@}

details.dk-source pre @{
    margin: 0;
    padding: 0.7rem 0.85rem;
    background: var(--dk-signature);
    border: 1px solid var(--dk-border);
    border-radius: 6px;
    font-size: 0.82rem;
    line-height: 1.55;
    tab-size: 4;
@}

.dk-tok-comment @{
    color: var(--dk-tok-comment);
    font-style: italic;
@}

.dk-tok-string @{
    color: var(--dk-tok-string);
@}

.dk-tok-number @{
    color: var(--dk-tok-number);
@}

.dk-tok-constant @{
    color: var(--dk-tok-constant);
@}

.dk-tok-keyword @{
    color: var(--dk-tok-keyword);
@}

.dk-tok-special @{
    color: var(--dk-tok-special);
    font-weight: 600;
@}

.dk-tok-paren @{
    color: var(--dk-tok-paren);
@}

/* --- the surfaces a reader reads through ---------------------------- */

/* Transparent, not see-through-by-accident: a browser without
   backdrop-filter keeps the solid surfaces declared above, and this is
   the page showing under the cards, the index and the bar. */

@@supports (backdrop-filter: blur(1px)) @{
    .dk-index @{
        background: color-mix(in srgb, var(--dk-card) 78%, transparent);
        -webkit-backdrop-filter: blur(var(--dk-blur)) saturate(130%);
        backdrop-filter: blur(var(--dk-blur)) saturate(130%);
    @}

    .dk-index-scroll @{
        background: color-mix(in srgb, var(--dk-card) 60%, transparent);
    @}

    .dk-index-filter @{
        background: color-mix(in srgb, var(--dk-signature) 70%, transparent);
    @}

    dl.def-block @{
        background: color-mix(in srgb, var(--dk-card) 78%, transparent);
        -webkit-backdrop-filter: blur(10px) saturate(120%);
        backdrop-filter: blur(10px) saturate(120%);
    @}

    dl.def-block > dt.def-line @{
        background: color-mix(in srgb, var(--dk-signature) 70%, transparent);
    @}

    details.dk-source pre @{
        background: color-mix(in srgb, var(--dk-signature) 58%, transparent);
    @}
@}

/* --- diagrams ------------------------------------------------------- */

img.image @{
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1rem auto;
    padding: 0.5rem;
    background: #ffffff;
    border: 1px solid var(--dk-border);
    border-radius: var(--dk-radius);
@}

.dk-diagram @{
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    overflow-x: auto;
    text-align: center;
    background: #ffffff;
    border: 1px solid var(--dk-border);
    border-radius: var(--dk-radius);
@}

.dk-diagram svg @{
    max-width: 100%;
    height: auto;
@}

/* --- focus ---------------------------------------------------------- */

.dk-index a:focus-visible,
.dk-icon:focus-visible,
.dk-copy:focus-visible,
.dk-toggle:focus-visible,
.dk-skip:focus-visible,
.dk-source > summary:focus-visible,
.dk-index-filter:focus-visible @{
    outline: 2px solid var(--dk-accent);
    outline-offset: 2px;
@}

/* --- the phone and the tablet --------------------------------------- */

@@media (max-width: 1024px) @{
    body.dk-has-index @{
        margin-left: 0;
        padding: 0 1.1rem 4rem;
    @}

    .dk-bar @{
        margin: 0 -1.1rem;
        padding: 0.5rem 1.1rem;
    @}

    .dk-menu @{
        display: inline-flex;
    @}

    .dk-index @{
        width: min(86vw, 20rem);
        visibility: hidden;
        transform: translateX(-103%);
        /* Stay visible while the drawer slides away, then leave the tab
           order; opening makes it visible at once so the filter can take
           the focus. */
        transition: transform 0.24s var(--dk-ease), visibility 0s linear 0.24s;
    @}

    /* A closed drawer is out of the tab order too, not only out of sight. */
    body.dk-index-open .dk-index @{
        visibility: visible;
        transform: none;
        transition: transform 0.24s var(--dk-ease), visibility 0s linear 0s;
        box-shadow: 0 0 0 1px var(--dk-border), 0 24px 64px rgba(8, 8, 12, 0.28);
    @}

    .dk-index-close @{
        display: inline-flex;
    @}

    body.dk-index-open @{
        overflow: hidden;
    @}

    .dk-scrim @{
        position: fixed;
        inset: 0;
        z-index: 45;
        display: block;
        background: rgba(20, 16, 12, 0.45);
    @}

    .dk-scrim[hidden] @{
        display: none;
    @}
@}

@@media (max-width: 600px) @{
    body.dk-has-index h2.chapter @{
        margin-top: 2rem;
        font-size: clamp(1.8rem, 8vw, 2.3rem);
    @}

    body.dk-has-index h3.section @{
        font-size: 1.35rem;
    @}

    body.dk-has-index h3.heading @{
        font-size: 1.2rem;
    @}

    body.dk-has-index h3.heading + ol.enumerate,
    body:not(.dk-has-index) h3.heading + ol.enumerate @{
        padding: 0.9rem 1rem 0.9rem 2.2rem;
    @}

    h2.chapter + p @{
        font-size: 1.08rem;
    @}

    dl.def-block @{
        padding: 0.75rem 0.85rem 0.9rem;
    @}

    dl.def-block > dt.def-line @{
        font-size: 0.9rem;
    @}

    dl.def-block .def-name @{
        font-size: 0.98rem;
    @}

    .dk-bar-title @{
        font-size: 0.92rem;
    @}

    body.dk-has-index table @{
        display: block;
        overflow-x: auto;
    @}
@}

/* --- print ---------------------------------------------------------- */

@@media print @{
    .dk-index,
    .dk-bar,
    .dk-skip,
    .dk-scrim,
    .dk-copy @{
        display: none !important;
    @}

    body,
    body.dk-has-index,
    body:not(.dk-has-index) @{
        max-width: none;
        margin: 0;
        padding: 0;
        background: none;
        font-size: 11pt;
    @}

    /* The index is not printed, so the body's own table of contents
       comes back for the paper. */
    body.dk-has-index ul.mini-toc,
    body.dk-flat .region-contents#SEC_Contents @{
        display: block;
    @}

    dl.def-block @{
        break-inside: avoid;
        border: 1px solid #cccccc;
        border-left: 3px solid #888888;
    @}

    body.dk-has-index h3.heading + ol.enumerate,
    body:not(.dk-has-index) h3.heading + ol.enumerate,
    body:not(.dk-has-index) #SEC_Contents,
    body:not(.dk-has-index) ul.mini-toc @{
        background: none;
        border-color: #cccccc;
    @}

    .dk-diagram,
    img.image @{
        break-inside: avoid;
    @}

    /* The source panel is a click on a screen and nothing on paper. */
    details.dk-source @{
        display: none !important;
    @}
@}
")

;
@end example

@end defvr


