@}

[data-dk-theme=\"dark\"] @{
    --dk-bg: #171411;
    --dk-fg: #ece5da;
    --dk-muted: #a99d8c;
    --dk-card: #1e1a15;
    --dk-signature: #272119;
    --dk-code: #241f19;
    --dk-border: #3a3127;
    --dk-accent: #d7a173;
    --dk-accent-strong: #e6c0a0;
